// ==================== TELEGRAM STARS PAYMENTS ====================

bot.onText(/\/buy/, withBotErrorBoundary("/buy", async (msg) => {
  const userId = uid(msg);
  dbHelpers.getOrCreateUser(userId, msg.from!.id, msg.from!.username || undefined, msg.from!.first_name || undefined);

  await bot.sendMessage(msg.chat.id,
    `💳 <b>Купить кредиты</b>\n\nВыбери пакет:\n\n⭐ 100 кредитов — 50 Stars\n⭐⭐ 300 кредитов — 120 Stars\n⭐⭐⭐ 1000 кредитов — 350 Stars`,
    {
      parse_mode: "HTML",
      reply_markup: {
        inline_keyboard: [
          [{ text: "100 кредитов — 50 ⭐", callback_data: "buy_100" }],
          [{ text: "300 кредитов — 120 ⭐", callback_data: "buy_300" }],
          [{ text: "1000 кредитов — 350 ⭐", callback_data: "buy_1000" }],
        ]
      }
    }
  );
}));

// Stars payment callbacks
const PACKAGES: Record<string, { credits: number; stars: number; label: string }> = {
  buy_100: { credits: 100, stars: 50, label: "100 кредитов" },
  buy_300: { credits: 300, stars: 120, label: "300 кредитов" },
  buy_1000: { credits: 1000, stars: 350, label: "1000 кредитов" },
};

bot.on("callback_query", withBotErrorBoundary("buy_callback", async (query) => {
  if (!query.data?.startsWith("buy_")) return;
  const pkg = PACKAGES[query.data];
  if (!pkg) return;

  await bot.answerCallbackQuery(query.id);

  try {
    await (bot as any).sendInvoice(
      query.message!.chat.id,
      `🦍 ${pkg.label}`,
      `Пополнение баланса Виталика на ${pkg.credits} кредитов`,
      `credits_${pkg.credits}_${query.from.id}`,
      "XTR", // Telegram Stars currency
      [{ label: pkg.label, amount: pkg.stars }]
    );
  } catch (err: any) {
    console.error("Stars invoice error:", err.message);
    await bot.sendMessage(query.message!.chat.id, "❌ Ошибка создания инвойса. Попробуй позже.");
  }
}));

// Pre-checkout query handler (must answer within 10s)
bot.on("pre_checkout_query", withBotErrorBoundary("pre_checkout_query", async (query) => {
  await bot.answerPreCheckoutQuery(query.id, true);
}));

// Successful payment handler
bot.on("message", withBotErrorBoundary("payment_message", async (msg: any) => {
  if (!msg.successful_payment) return;
  const payment = msg.successful_payment;
  const payload = payment.invoice_payload as string;
  
  // Parse credits from payload: credits_100_userId
  const match = payload.match(/^credits_(\d+)_/);
  if (!match) return;
  
  const credits = parseInt(match[1]);
  const userId = uid(msg);
  
  dbHelpers.addCredits(userId, credits);
  const newBalance = dbHelpers.getCredits(userId);
  
  await bot.sendMessage(msg.chat.id,
    `✅ <b>Оплата прошла!</b>\n\n+${credits} кредитов добавлено.\nНовый баланс: <b>${newBalance}</b> кредитов 💰`,
    { parse_mode: "HTML" }
  );
}));

bot.on("polling_error", (err) => {
  console.error("Polling error:", err);
});

process.once("SIGINT", () => { bot.stopPolling(); process.exit(0); });
process.once("SIGTERM", () => { bot.stopPolling(); process.exit(0); });


process.on("uncaughtException", (err) => {
  console.error("Uncaught exception:", err);
});

process.on("unhandledRejection", (reason) => {
  console.error("Unhandled rejection:", reason);
});
